{
  "name": "ByteMsg233",
  "scopeName": "source.bmsg",
  "patterns": [
    {
      "name": "comment.line.double-slash.bmsg",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.bmsg",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bmsg",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.bmsg",
      "match": "\\b(schema|package|namespace|message|enum|protocolVersion)\\b"
    },
    {
      "name": "support.type.bmsg",
      "match": "\\b(uint32|uint64|int32|int64|float32|float64|string|bool|bytes|list|map)\\b"
    },
    {
      "name": "entity.name.type.bmsg",
      "match": "(?<=message )\\w+|(?<=enum )\\w+"
    },
    {
      "name": "variable.other.field.bmsg",
      "match": "\\b\\w+(?=\\s*=)"
    },
    {
      "name": "constant.numeric.bmsg",
      "match": "-?\\b\\d+\\b"
    },
    {
      "name": "keyword.operator.bmsg",
      "match": "[=:<>|]"
    },
    {
      "name": "punctuation.section.bmsg",
      "match": "[{}\\[\\],]"
    }
  ]
}
